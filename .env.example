# Copy to .env (git-ignored) and fill in. Load with:  set -a; source .env; set +a
# Single-quote values that contain & (the Postgres URL does).
MLFLOW_TRACKING_URI='postgresql+psycopg2://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require'

# Neon Object Storage, WRITE credential (training pipeline, register_model.py)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MLFLOW_S3_ENDPOINT_URL=https://<branch>.storage.<region>.aws.neon.tech
AWS_DEFAULT_REGION=us-east-2

# READ-ONLY credential (app.py only reads weights)
AWS_RO_ACCESS_KEY_ID=
AWS_RO_SECRET_ACCESS_KEY=
