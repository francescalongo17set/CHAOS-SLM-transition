# --- data-generation: inputs we do not redistribute / regenerable artefacts ---
# Source PDFs (third-party insurance documents): keep local, re-add under raw/ to rebuild.
data-generation/data/raw/
# Page text extracted verbatim from the PDFs: regenerated by code/extract.py.
data-generation/data/extracted/
# Embedding matrices (about 14 MB): regenerated by code/embed.py. Config JSONs stay tracked.
data-generation/data/index/*.npy

# Kaggle bundle (kev/make_bundle.py)
orchestrator/baselines/dist/
